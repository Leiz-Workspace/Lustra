{
  "name": "lustra-desktop",
  "productName": "Lustra",
  "desktopName": "lustra.desktop",
  "version": "2.0.6",
  "description": "Lustra desktop UI (Electron) for the Lustra booru downloader core",
  "homepage": "https://github.com/Leiz-Workspace/Lustra",
  "author": "Lustra contributors",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --enable-logging --lustra-devtools",
    "check": "node --check main.js && node --check preload.js && node --check renderer/app.js && node --check renderer/guide.js && node --check renderer/mock.js && node --check tag-schedule.js && node test/tag-schedule.test.js",
    "check:core": "node -e \"if (!require('fs').existsSync('build/core/lustra-core')) { console.error('frozen core missing: run python tools/build_core.py in the repo root first'); process.exit(1); }\"",
    "dist": "npm run check:core && electron-builder --publish never",
    "dist:dir": "npm run check:core && electron-builder --dir --publish never"
  },
  "build": {
    "appId": "app.lustra.desktop",
    "productName": "Lustra",
    "copyright": "MIT License, Lustra contributors (based on the original work of trickerer01)",
    "artifactName": "lustra-${os}-${arch}_v${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon-utils.js",
      "tag-schedule.js",
      "package.json",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "build/core/lustra-core",
        "to": "core",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "afterPack": "build/after-pack.js",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "lustra",
      "syncDesktopName": true,
      "icon": "assets/icons/full-mask-orange.png",
      "category": "Network",
      "synopsis": "Booru downloader",
      "description": "Booru downloader",
      "executableArgs": [],
      "maintainer": "DungeonLeiz <korosakiryukai@gmail.com>",
      "vendor": "DungeonLeiz"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/full-mask-orange.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lustra",
      "artifactName": "lustra-setup-${arch}_v${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icons/full-mask-orange.png",
      "identity": null
    },
    "deb": {
      "packageCategory": "net"
    },
    "publish": null
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  }
}
