{
  "$schema": "../../../docs/schemas/extension-manifest.schema.json",
  "id": "rule34",
  "name": "Rule34",
  "abbr": "rx",
  "version": "2.0.0",
  "apiVersion": 1,
  "kind": "downloader",
  "default": true,
  "site": "https://rule34.xxx/",
  "media": [
    "image",
    "video"
  ],
  "entry": "lustra.download_rx:DownloaderRx",
  "tagList": "rx_tags.json",
  "description": "Gelbooru-based DAPI (XML). API key + user id recommended.",
  "auth": {
    "apiKey": true,
    "apiKeyFormat": "KEY,USER_ID",
    "cookies": [
      "cf_clearance",
      "user_id",
      "pass_hash"
    ]
  },
  "syntax": {
    "concat": "+",
    "idSep": ":",
    "maxTagsStringLen": 3300,
    "metaCount": ":(?:(?:[<>]=?|=)?[a-z\\d\\-_]+?|[a-z\\d_]+:[a-z\\d_]+?)",
    "sort": "sort(?::[^:]+?){1,2}",
    "fav": "favorited_by:\\d+?",
    "pool": "pool:\\d+?"
  }
}
